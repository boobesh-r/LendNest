# LendNest Production Frontend Configuration
# If the single Docker container or reverse proxy serves both frontend and /api on the same domain:
VITE_API_BASE=/api

# If frontend is hosted on a separate CDN/subdomain (e.g., Vercel/Netlify with backend on Render/VPS):
# VITE_API_BASE=https://api.lendnest.yourdomain.com/api
