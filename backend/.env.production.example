# LendNest Production Backend Configuration
PORT=5000
NODE_ENV=production

# IMPORTANT: Generate a 64-character cryptographically secure random secret
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_64_character_crypto_random_secret_string

# Absolute path to persistent SQLite database file
DATABASE_PATH=/app/database/lendnest.sqlite

# Full HTTPS origin of your frontend domain (used for CORS and redirect security)
FRONTEND_URL=https://lendnest.yourdomain.com
CORS_ORIGIN=https://lendnest.yourdomain.com

# Enable/disable simulated demo services in production (default: false for real launch)
ENABLE_DEMO_SERVICES=false

# -------------------------------------------------------------
# Optional Production Integrations (To be filled before launch)
# -------------------------------------------------------------
# Razorpay / Stripe Live Payment Gateway Keys:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx

# Physical IoT Locker Controller Relay API:
# IOT_LOCKER_RELAY_URL=https://lockers-api.yourdomain.com/unlock
# IOT_LOCKER_API_KEY=xxxxxxxxxxxxxxxx
