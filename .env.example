# LendNest Environment Configuration Template

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# JWT Secret Key (Use a random 64-char string for production: `openssl rand -hex 32`)
JWT_SECRET=lendnest_super_secure_jwt_secret_key_2026_production_seed

# Database path (relative or absolute)
DATABASE_PATH=../database/lendnest.sqlite

# Frontend URL (for CORS and client redirects)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Demo sandbox services toggle (set to false for public launch)
ENABLE_DEMO_SERVICES=true
